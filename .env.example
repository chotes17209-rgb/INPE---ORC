# ──────────────────────────────────────────────────────────────
#  Sistema Integrado de Gestión Administrativa — INPE ORC
#  Copie este archivo como ".env" y complete los valores.
#  NUNCA publique el archivo .env (contiene claves privadas).
# ──────────────────────────────────────────────────────────────

APP_NAME="Sistema Integrado de Gestión Administrativa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos (MySQL 8 / MariaDB 10.6+)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erp_inpe_orc
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_FROM_ADDRESS="erp@inpe-orc.gob.pe"
MAIL_FROM_NAME="${APP_NAME}"

# ── Datos institucionales (cabeceras, reportes y comprobantes) ──
INPE_SECTOR="Ministerio de Justicia y Derechos Humanos"
INPE_INSTITUCION="Instituto Nacional Penitenciario"
INPE_SIGLAS=INPE
INPE_OFICINA="Oficina Regional Centro"
INPE_SEDE=Huancayo
INPE_AREA="Área Administrativa"
INPE_RUC=20131370564

# ── Asistente de inteligencia artificial ──
# Compatible con cualquier proveedor con API tipo OpenAI "chat completions".
#   Groq:   IA_BASE_URL=https://api.groq.com/openai/v1   IA_MODEL=llama-3.3-70b-versatile
#   OpenAI: IA_BASE_URL=https://api.openai.com/v1        IA_MODEL=gpt-4o-mini
IA_API_KEY=
IA_MODEL=llama-3.3-70b-versatile
IA_BASE_URL=https://api.groq.com/openai/v1
IA_TIMEOUT=60

# ── Consulta de RUC (SUNAT) ──
# json.pe busca en ambos sentidos: RUC → razón social y razón social → RUC.
#   Token gratuito en https://json.pe (registro con correo).
JSONPE_TOKEN=
JSONPE_URL=https://api.json.pe/api
# Alternativa solo RUC → razón social: decolecta (antes apis.net.pe).
#   decolecta:   APIPERU_URL=https://api.decolecta.com/v1
#   apis.net.pe: APIPERU_URL=https://api.apis.net.pe/v2
APIPERU_TOKEN=
APIPERU_URL=https://api.decolecta.com/v1
